{
  "name": "nizhal-monorepo",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "check-types": "turbo run check-types",
    "test": "turbo run test --concurrency=1 && pnpm chaos",
    "chaos": "pnpm --filter emulation chaos",
    "example:byo": "pnpm --filter @nizhal/example-notes example:byo",
    "lint": "biome check .",
    "format": "biome format --write .",
    "version": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@changesets/cli": "^2.29.8",
    "turbo": "^2.8.14",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "overrides": {
      "drizzle-orm": "^0.45.2",
      "react-native": "0.85.3",
      "react": "19.2.3",
      "react-dom": "19.2.3"
    },
    "patchedDependencies": {
      "expo-modules-jsi@56.0.10": "patches/expo-modules-jsi@56.0.10.patch"
    }
  }
}
