{
  "name": "@nizhal/example-tabkeep",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build",
    "check-types": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.examples.json",
    "test": "vitest run",
    "dev": "vite",
    "dev:server": "tsx examples/demo-server.ts",
    "dev:server:cf": "tsx examples/cf-demo-server.ts",
    "migrate": "nizhal migrate --config ./nizhal.config.ts",
    "example:e2e": "tsx examples/e2e.ts",
    "example:realtime": "tsx examples/realtime.ts",
    "example:divergence": "tsx examples/divergence.ts",
    "example:chain": "tsx examples/chain-e2e.ts",
    "example:chain-receipts": "tsx examples/chain-receipts.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.14",
    "@nizhal/db-collection": "workspace:*",
    "@nizhal/kernel": "workspace:*",
    "@nizhal/server": "workspace:*",
    "@tanstack/db": "^0.6.12",
    "@tanstack/react-db": "^0.1.60",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.27",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "wa-sqlite": "^1.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.3",
    "@nizhal/cli": "workspace:*",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.22.4",
    "typescript": "^5.9.2",
    "vite": "^6.0.5",
    "vitest": "^3.2.4"
  }
}
