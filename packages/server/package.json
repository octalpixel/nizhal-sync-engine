{
  "name": "@nizhal/server",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./adapters": {
      "types": "./dist/adapters/index.d.ts",
      "default": "./dist/adapters/index.js"
    },
    "./adapters/cloudflare": {
      "types": "./dist/adapters/cloudflare/index.d.ts",
      "default": "./dist/adapters/cloudflare/index.js"
    },
    "./adapters/cloudflare/realtime": {
      "types": "./dist/adapters/cloudflare/realtime.d.ts",
      "default": "./dist/adapters/cloudflare/realtime.js"
    },
    "./adapters/libsql-audit": {
      "types": "./dist/adapters/libsql-audit.d.ts",
      "default": "./dist/adapters/libsql-audit.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.14",
    "@hono/node-ws": "^1.3.1",
    "@libsql/client": "^0.17.4",
    "@nizhal/kernel": "workspace:*",
    "aws4fetch": "^1.0.20",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.6.14",
    "partyserver": "^0.5.8",
    "postgres": "^3.4.5",
    "ws": "^8.21.0",
    "yjs": "^13.6.31"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "@electric-sql/pglite": "^0.5.3",
    "@types/node": "^22.10.5",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "license": "MIT"
}
